---
import type { Post } from '../utils';
import { formatDate, readingMinutes, postUrl, postLang, tagUrl } from '../utils';
import { t } from '../i18n';

interface Props {
  post: Post;
  /** Position in the list, shown as a small "01" label on the image. */
  index?: number;
  featured?: boolean;
}
const { post, index, featured = false } = Astro.props;
const { title, description, pubDate, heroImage, tags, draft } = post.data;
const lang = postLang(post);
const s = t(lang);
const url = postUrl(post);
---

<article class:list={['card', { 'card-featured': featured }]}>
  <div class="card-media">
    {index !== undefined && <span class="card-index">{featured ? s.home.latest : String(index).padStart(2, '0')}</span>}
    {heroImage ? (
      <img src={heroImage} alt="" loading={featured ? 'eager' : 'lazy'} decoding="async" />
    ) : (
      <div class="placeholder" aria-hidden="true"><span class="logo-lens">&lt;/&gt;</span></div>
    )}
  </div>
  <div class="card-body">
    <p class="meta">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
      <span class="sep" aria-hidden="true">/</span>
      <span>{s.card.minRead(readingMinutes(post.body))}</span>
      {draft && <span class="badge">{s.card.draft}</span>}
    </p>
    <h2 class="card-title"><a href={url}>{title}</a></h2>
    <p class="card-desc">{description}</p>
    <div class="card-foot">
      {tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => <li><a href={tagUrl(lang, tag)}>{tag}</a></li>)}
        </ul>
      )}
      {featured && <span class="read-more" aria-hidden="true">{s.card.read}</span>}
    </div>
  </div>
</article>
