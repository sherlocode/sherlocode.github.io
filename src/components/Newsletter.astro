---
import { BUTTONDOWN_USERNAME } from '../consts';
import { localizePath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** "band" = wide section (home), "card" = compact box (end of article). */
  variant?: 'band' | 'card';
  /** Where the signup happened, saved as a Buttondown tag (e.g. "home", "article"). */
  source?: string;
}
const { lang, variant = 'card', source = 'site' } = Astro.props;
const s = t(lang).newsletter;
const enabled = BUTTONDOWN_USERNAME.trim() !== '';
const action = `https://buttondown.com/api/emails/embed-subscribe/${BUTTONDOWN_USERNAME}`;
const id = `nl-${source}`;
---

{enabled && (
  <section class:list={['newsletter', `newsletter-${variant}`]} aria-labelledby={`${id}-title`}>
    <div class="newsletter-text">
      <p class="label label-accent">{s.eyebrow}</p>
      <h2 id={`${id}-title`}>{s.title}</h2>
      <p>{s.text}</p>
    </div>
    <form class="newsletter-form" action={action} method="post" target="_blank">
      <label class="sr-only" for={`${id}-email`}>{s.email}</label>
      <div class="newsletter-row">
        <input id={`${id}-email`} type="email" name="email" placeholder={s.placeholder} autocomplete="email" required />
        <input type="hidden" name="embed" value="1" />
        <input type="hidden" name="tag" value={source} />
        <input type="hidden" name="tag" value={`lang-${lang}`} />
        <button class="button" type="submit" data-umami-event="Newsletter signup" data-umami-event-source={source} data-umami-event-lang={lang}>{s.button}</button>
      </div>
      <p class="newsletter-note">
        {s.note[0]}<a href={localizePath(lang, '/privacy/')}>{s.note[1]}</a>{s.note[2]}
      </p>
    </form>
  </section>
)}
