---
import Logo from './Logo.astro';

interface Props {
  /** Shows a reading-progress bar under the header (article pages). */
  progress?: boolean;
}
const { progress = false } = Astro.props;

const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Articles', active: path === '/' || path.startsWith('/blog') },
  { href: '/tag/', label: 'Topics', active: path.startsWith('/tag') },
  { href: '/about/', label: 'About', active: path.startsWith('/about') },
];
---

<header class="site-header">
  <div class="wrap header-inner">
    <Logo />
    <nav class="site-nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={l.active ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
  {progress && <div class="progress" id="progress" aria-hidden="true"></div>}
</header>

{progress && (
  <script>
    const bar = document.getElementById('progress');
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? Math.min(1, window.scrollY / max) : 0;
      if (bar) bar.style.transform = `scaleX(${ratio})`;
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  </script>
)}
