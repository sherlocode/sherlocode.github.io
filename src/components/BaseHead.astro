---
import '../styles/global.css';
import Analytics from './Analytics.astro';
import { SITE_TITLE, AUTHOR } from '../consts';
import { LANGS, LANG_META, DEFAULT_LANG, localizePath, type Lang } from '../i18n';

export interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** URL path of this page in each language (used for hreflang and the language switcher). */
  alternates?: Partial<Record<Lang, string>>;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  tags?: string[];
}

const { title, description, lang, alternates = {}, image, type = 'website', publishedTime, tags = [] } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// LinkedIn requires an absolute PNG or JPG image (not SVG), ideally 1200×627.
const ogImage = new URL(image && /\.(png|jpe?g)$/i.test(image) ? image : '/og-default.png', Astro.site);
const fullTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;
const hreflang = LANGS.filter((l) => alternates[l]).map((l) => ({ lang: l, href: new URL(alternates[l]!, Astro.site) }));
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} (${LANG_META[lang].name})`} href={new URL(localizePath(lang, '/rss.xml'), Astro.site)} />
<link rel="canonical" href={canonicalURL} />
{hreflang.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
{alternates[DEFAULT_LANG] && <link rel="alternate" hreflang="x-default" href={new URL(alternates[DEFAULT_LANG]!, Astro.site)} />}
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="author" content={AUTHOR} />

<!-- Open Graph metadata used by LinkedIn for link previews -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={LANG_META[lang].og} />
{LANGS.filter((l) => l !== lang && alternates[l]).map((l) => <meta property="og:locale:alternate" content={LANG_META[l].og} />)}
{type === 'article' && <meta property="article:author" content={AUTHOR} />}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{tags.map((t) => <meta property="article:tag" content={t} />)}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<Analytics />
