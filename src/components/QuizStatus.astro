---
/*
 * Fills every element marked with data-quiz-status="<storage key>" with the result
 * saved in this browser. Texts come from data-empty, data-best-label and data-retake. Include it once on any page that shows quiz badges.
 */
---

<script>
  type Saved = { best: number; last: number; total: number; attempts: number; date: string };
  const read = (key: string): Saved | null => {
    try {
      const raw = localStorage.getItem(key);
      return raw ? (JSON.parse(raw) as Saved) : null;
    } catch {
      return null;
    }
  };

  const fill = () => {
    let done = 0;
    let sum = 0;
    const cards = document.querySelectorAll<HTMLElement>('[data-quiz-status]');
    for (const node of cards) {
      const saved = read(node.dataset.quizStatus!);
      const total = Number(node.dataset.total) || saved?.total || 0;
      const host = node.closest<HTMLElement>('[data-quiz-card]');
      if (!saved) {
        node.textContent = node.dataset.empty ?? '';
        node.classList.remove('is-done', 'is-perfect');
        continue;
      }
      done++;
      sum += total ? saved.best / total : 0;
      const perfect = saved.best === total;
      node.textContent = `${perfect ? '★ ' : ''}${node.dataset.bestLabel ?? 'Best'} ${saved.best} / ${total}`;
      node.classList.add('is-done');
      node.classList.toggle('is-perfect', perfect);
      host?.classList.add('is-done');
      const action = host?.querySelector<HTMLElement>('[data-quiz-action]');
      if (action) action.textContent = node.dataset.retake ?? 'Retake →';
    }
    const summary = document.querySelector<HTMLElement>('[data-quiz-summary]');
    if (summary) {
      summary.querySelector('[data-done]')!.textContent = String(done);
      summary.querySelector('[data-avg]')!.textContent = done ? `${Math.round((sum / done) * 100)}%` : '—';
    }
  };
  fill();
  // Refresh when coming back with the browser's back button (bfcache).
  window.addEventListener('pageshow', fill);
</script>
