---
import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LANGS, localizePath, stripLang, t } from '../i18n';

type Props = Omit<HeadProps, 'alternates'> & {
  /**
   * URL path of this page in each language. If omitted, the same path is assumed in every
   * language (true for home, topics, quiz list, about, privacy).
   */
  alternates?: HeadProps['alternates'];
};

const props = Astro.props;
const { lang } = props;
const base = stripLang(Astro.url.pathname);
const alternates = props.alternates ?? Object.fromEntries(LANGS.map((l) => [l, localizePath(l, base)]));
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead {...props} alternates={alternates} />
  </head>
  <body>
    <a class="skip" href="#main">{t(lang).skip}</a>
    <Header lang={lang} alternates={alternates} progress={props.type === 'article'} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
