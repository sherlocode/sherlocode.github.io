---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
// Each language has its own file: src/content/pages/<lang>/about.md
const page = (await getEntry('pages', `${lang}/about`)) ?? (await getEntry('pages', 'en/about'));
if (!page) throw new Error('Missing src/content/pages/en/about.md');
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description} lang={lang}>
  <section class="post-header grid-bg">
    <div class="wrap-narrow">
      <p class="label label-accent">// {t(lang).nav.about}</p>
      <h1 style="margin-top:18px">{page.data.title}</h1>
      <p class="lede">{page.data.description}</p>
    </div>
  </section>
  <div class="prose wrap-narrow">
    <Content />
  </div>
</BaseLayout>
