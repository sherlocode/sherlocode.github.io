---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUTTONDOWN_USERNAME, UMAMI_WEBSITE_ID, LINKEDIN_URL } from '../consts';

const newsletter = BUTTONDOWN_USERNAME.trim() !== '';
const analytics = UMAMI_WEBSITE_ID.trim() !== '';
const updated = 'November 2026';
---

<BaseLayout title="Privacy" description="What this site stores, measures and why.">
  <section class="post-header grid-bg">
    <div class="wrap-narrow">
      <p class="label label-accent">// Privacy</p>
      <h1 style="margin-top:18px">Privacy notes</h1>
      <p class="lede">Short and plain: what this site stores, what it measures and why. Last updated {updated}.</p>
    </div>
  </section>

  <div class="prose wrap-narrow">
    <h2>No cookies, no ads</h2>
    <p>This site does not use cookies, advertising or tracking across other websites. It is a static site hosted on GitHub Pages, which may log basic technical data (such as IP addresses) to keep the service running and secure.</p>

    <h2>Quiz results</h2>
    <p>Your quiz scores are saved only in your browser (<code>localStorage</code>), so you can see your progress when you come back. They are never sent to me or anyone else. You can delete them at any time by clearing this site’s data in your browser.</p>

    {analytics && (
      <>
        <h2>Anonymous statistics</h2>
        <p>I use <a href="https://umami.is" target="_blank" rel="noopener">Umami</a> to count visits and a few actions (for example a completed quiz or a click on “Share”). Umami does not use cookies, does not collect personal data and does not follow you across sites. If your browser sends a “Do Not Track” signal, no statistics are collected.</p>
      </>
    )}

    {newsletter && (
      <>
        <h2>Newsletter</h2>
        <p>If you subscribe, your email address is stored by <a href="https://buttondown.com" target="_blank" rel="noopener">Buttondown</a>, the service that sends the newsletter. It is used only to send you new articles. You will receive a confirmation email before being added, and every email has an unsubscribe link.</p>
      </>
    )}

    <h2>Questions</h2>
    <p>Write to me on <a href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn</a> for any question about your data.</p>
  </div>
</BaseLayout>
