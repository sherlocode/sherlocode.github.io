---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, collectTags, tagSlug, type Post } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return collectTags(posts).map((t) => ({
    params: { tag: t.slug },
    props: { name: t.name, posts: posts.filter((p) => p.data.tags.some((x) => tagSlug(x) === t.slug)) },
  }));
}

interface Props {
  name: string;
  posts: Post[];
}
const { name, posts } = Astro.props;
---

<BaseLayout title={name} description={`Articles about ${name}.`}>
  <section class="hero wrap">
    <p class="eyebrow"><a href="/tag/">Topics</a></p>
    <h1>{name}</h1>
    <p class="lede">{posts.length} {posts.length === 1 ? 'article' : 'articles'}</p>
  </section>
  <section class="wrap post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </section>
</BaseLayout>
