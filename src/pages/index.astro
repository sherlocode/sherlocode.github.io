---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getPublishedPosts, collectTags } from '../utils';

const posts = await getPublishedPosts();
const allTags = collectTags(posts);
const tags = allTags.slice(0, 12);
const [latest, ...rest] = posts;
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero grid-bg">
    <div class="wrap">
      <p class="label label-accent">// A personal library</p>
      <h1>What I’m learning, written for <em>those who come next.</em></h1>
      <p class="lede">{SITE_DESCRIPTION}</p>
      <div class="hero-stats">
        <div><strong>{posts.length}</strong><span>Articles</span></div>
        <div><strong>{allTags.length}</strong><span>Topics</span></div>
      </div>
    </div>
  </section>

  <section class="wrap" aria-labelledby="articles-title">
    <div class="section-head">
      <h2 id="articles-title"><i>01</i>Articles</h2>
      {tags.length > 0 && (
        <ul class="tags tags-lg" aria-label="Topics">
          {tags.map((t) => <li><a href={`/tag/${t.slug}/`}>{t.name}<span>{t.count}</span></a></li>)}
        </ul>
      )}
    </div>

    {posts.length === 0 && <p class="empty">No articles yet. The first one is coming soon.</p>}
    {latest && <PostCard post={latest} index={posts.length} featured />}
    <div class="post-grid">
      {rest.map((post, i) => <PostCard post={post} index={posts.length - 1 - i} />)}
    </div>
  </section>

  <div class="wrap">
    <Newsletter variant="band" source="home" />
  </div>
</BaseLayout>
